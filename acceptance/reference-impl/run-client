#!/usr/bin/env bash
# Запускает эталонный клиент через docker compose, не напрямую на хосте.
# Клиент и сервер — в общей сети проекта (обычная сеть compose, без
# network_mode/depends_on — см. docker-compose.yml, почему). Порт из
# полученного --server URL используется только для вычисления имени
# проекта (project_for_port — то же правило, что и в run-server); сам
# --server, с которым видит вызов клиент внутри контейнера, переписан
# на "http://server:<port>" — по имени сервиса, которое резолвит
# встроенный DNS compose, а не по хосту/порту, которые видел вызывающий
# снаружи (тот мог быть 127.0.0.1 или заведомо нерезолвящийся хост для
# теста на недоступный сервер — оба случая корректно доходят до клиента
# как есть, потому что реальный DNS-запрос идёт от имени "server").
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091  # путь резолвится в рантайме через BASH_SOURCE
source "$DIR/_docker.sh"

if [[ $# -lt 2 ]]; then
  echo "run-client: использование: run-client <push|pull|sync|status> <dir> --server <url>" >&2
  exit 1
fi

SUBCOMMAND="$1"
LOCAL_DIR="$2"
shift 2
mkdir -p "$LOCAL_DIR"
LOCAL_DIR="$(cd "$LOCAL_DIR" && pwd)"

SERVER_URL=""
SERVER_ARG_INDEX=-1
declare -a forwarded=("$@")
i=0
while [[ $i -lt ${#forwarded[@]} ]]; do
  if [[ "${forwarded[$i]}" == "--server" ]]; then
    SERVER_URL="${forwarded[$((i + 1))]}"
    SERVER_ARG_INDEX=$((i + 1))
  fi
  i=$((i + 1))
done
if [[ -z "$SERVER_URL" ]]; then
  echo "run-client: требуется --server <url>" >&2
  exit 1
fi
PORT="${SERVER_URL##*:}"
PORT="${PORT%%/*}"
forwarded[SERVER_ARG_INDEX]="http://server:${PORT}"

export LOCAL_DIR PORT
PROJECT="$(project_for_port "$PORT")"

# Не через compose() из _docker.sh: exec не умеет запускать shell-функции,
# только внешние команды — раскрываем вызов явно.
exec docker compose -f "$COMPOSE_FILE" -p "$PROJECT" run --rm --build client \
  python3 client.py "$SUBCOMMAND" "$LOCAL_DIR" "${forwarded[@]}"
