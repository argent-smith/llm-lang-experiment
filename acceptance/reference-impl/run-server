#!/usr/bin/env bash
# Запускает эталонный сервер через docker compose, не напрямую на хосте —
# изоляция среды выполнения "стенда" от хоста (в т.ч. от особенностей
# хостовой ФС — см. историю бага с кодировкой ключа на APFS в server.py).
# Всё Docker-хозяйство здесь идёт через compose (docker-compose.yml),
# сырых docker run/build в обёртке нет.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091  # путь резолвится в рантайме через BASH_SOURCE
source "$DIR/_docker.sh"

DATA_DIR=""
PORT=""
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  case "${args[$i]}" in
    --data-dir)
      DATA_DIR="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    --port)
      PORT="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    *)
      i=$((i + 1))
      ;;
  esac
done

if [[ -z "$DATA_DIR" || -z "$PORT" ]]; then
  echo "run-server: требуется --data-dir <path> --port <n>" >&2
  exit 1
fi
mkdir -p "$DATA_DIR"
DATA_DIR="$(cd "$DATA_DIR" && pwd)"

export DATA_DIR PORT
# shellcheck disable=SC2034  # используется в compose() из _docker.sh
PROJECT="$(project_for_port "$PORT")"

# На случай, если предыдущий прогон на этом же порту не почистился.
compose down --remove-orphans >/dev/null 2>&1 || true

# Не exec: тому, кто нас запустил (smoke.sh/contract-test.sh), нужно
# послать нам kill и рассчитывать, что контейнер реально остановится.
# exec подменил бы этот процесс собой compose up и обработчик сигнала
# в bash-скрипте перестал бы существовать. Вместо этого держим compose up
# фоновым job'ом и ждём его через `wait <pid>`, который прерывается
# сигналом, позволяя trap отработать `compose down` до выхода из скрипта.
compose up --build server &
COMPOSE_PID=$!

cleanup() {
  compose down --remove-orphans >/dev/null 2>&1 || true
  wait "$COMPOSE_PID" 2>/dev/null || true
}
trap cleanup EXIT TERM INT

wait "$COMPOSE_PID"
