#!/usr/bin/env bash
# Builds the test image and runs the whole test suite inside Docker (via
# docker compose). Exits non-zero if any test fails.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec docker compose --project-directory "$repo" -f "$repo/compose.yaml" \
  run --rm --build -T test
