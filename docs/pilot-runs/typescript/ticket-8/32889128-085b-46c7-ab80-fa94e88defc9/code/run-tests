#!/usr/bin/env bash
# Runs the syncbox implementation's automated test suite inside Docker.
# See SYNCBOX-SPEC.md, section "Критерии приёмки".
#
# Usage: run-tests
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

status=0

echo "==> server tests"
docker compose run --build --rm tests
if [[ $? -ne 0 ]]; then status=1; fi

echo "==> client tests"
docker compose run --build --rm client-tests
if [[ $? -ne 0 ]]; then status=1; fi

exit "$status"
