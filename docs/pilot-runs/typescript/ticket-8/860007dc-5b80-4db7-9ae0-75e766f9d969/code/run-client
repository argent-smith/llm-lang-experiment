#!/usr/bin/env bash
# Launches the Syncbox client inside a Docker container via docker compose.
# Usage: run-client <push|pull|sync|status> <dir> --server <url>
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

if [[ $# -lt 2 ]]; then
  echo "run-client: usage: run-client <push|pull|sync|status> <dir> --server <url>" >&2
  exit 1
fi

command_name="$1"
dir="$2"
shift 2

case "$command_name" in
  push | pull | sync | status) ;;
  *)
    echo "run-client: unknown command: $command_name (expected push, pull, sync, or status)" >&2
    exit 1
    ;;
esac

mkdir -p "$dir"
dir="$(cd "$dir" && pwd)"

export SYNCBOX_CLIENT_DIR="$dir"

exec docker compose -f docker-compose.client.yml -p syncbox-client run --rm --no-deps client "$command_name" /workdir "$@"
