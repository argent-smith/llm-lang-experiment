#!/usr/bin/env bash
# Runs the syncbox server in the foreground (no daemonization), inside a
# Docker container built/managed via docker compose. See SYNCBOX-SPEC.md,
# sections "CLI (обязательный контракт)" and "Docker-изоляция".
#
# Usage: run-server --data-dir <path> --port <n>
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

data_dir=""
port="${SYNCBOX_PORT:-8080}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --data-dir)
      data_dir="${2:-}"
      shift 2
      ;;
    --port)
      port="${2:-}"
      shift 2
      ;;
    *)
      echo "run-server: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$data_dir" ]]; then
  data_dir="${SYNCBOX_DATA_DIR:-}"
fi

if [[ -z "$data_dir" ]]; then
  echo "run-server: --data-dir is required (or SYNCBOX_DATA_DIR)" >&2
  exit 1
fi

mkdir -p "$data_dir"
data_dir="$(cd "$data_dir" && pwd)"

export SYNCBOX_DATA_DIR_HOST="$data_dir"
export SYNCBOX_PORT="$port"

exec docker compose up --build server
