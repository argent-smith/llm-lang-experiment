#!/usr/bin/env bash
# Runs the Syncbox server inside its Docker container via docker compose,
# in the foreground (no daemonization). Usage:
#   run-server --data-dir <path> --port <n>
# Falls back to SYNCBOX_DATA_DIR / SYNCBOX_PORT when the flags are omitted,
# mirroring the server's own flag/env precedence.
set -euo pipefail

DATA_DIR="${SYNCBOX_DATA_DIR:-}"
PORT="${SYNCBOX_PORT:-8080}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --data-dir)
      DATA_DIR="$2"
      shift 2
      ;;
    --data-dir=*)
      DATA_DIR="${1#*=}"
      shift
      ;;
    --port)
      PORT="$2"
      shift 2
      ;;
    --port=*)
      PORT="${1#*=}"
      shift
      ;;
    *)
      echo "run-server: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$DATA_DIR" ]]; then
  echo "run-server: --data-dir is required (or set SYNCBOX_DATA_DIR)" >&2
  exit 1
fi

mkdir -p "$DATA_DIR"
DATA_DIR="$(cd "$DATA_DIR" && pwd)"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

exec docker compose run --rm -T \
  -p "${PORT}:${PORT}" \
  -v "${DATA_DIR}:/data" \
  server \
  --data-dir /data --port "${PORT}"
