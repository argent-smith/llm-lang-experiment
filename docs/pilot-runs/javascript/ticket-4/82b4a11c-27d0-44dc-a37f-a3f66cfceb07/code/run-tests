#!/usr/bin/env bash
# Runs the Syncbox test suite via docker compose (tests always run
# containerized, never directly on the host).
#
# Usage: run-tests
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec docker compose -f "$REPO_ROOT/docker-compose.yml" run --rm --build tests
