#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: run-client <push|pull|sync|status> <dir> --server <url>" >&2
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
  push|pull|sync|status)
    ;;
  *)
    echo "run-client: unknown command: $COMMAND" >&2
    usage
    exit 1
    ;;
esac

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

DIR="$1"
shift

mkdir -p "$DIR"
DIR_ABS="$(cd "$DIR" && pwd)"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

export SYNCBOX_CLIENT_DIR_HOST="$DIR_ABS"

PROJECT="syncbox-client-$$"

cleanup() {
  docker compose -p "$PROJECT" down --remove-orphans --timeout 5 >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker compose -p "$PROJECT" run --rm -T client "$COMMAND" /workdir "$@"
