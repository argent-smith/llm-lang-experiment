#!/usr/bin/env bash
# Wraps `docker compose run` so the server can be launched with the
# CLI contract from SYNCBOX-SPEC.md:
#   run-server --data-dir <path> --port <n>
# Runs in the foreground in the current process (no daemonizing).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

data_dir=""
port=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --data-dir)
      [[ $# -ge 2 ]] || { echo "run-server: --data-dir requires a value" >&2; exit 1; }
      data_dir="$2"
      shift 2
      ;;
    --port)
      [[ $# -ge 2 ]] || { echo "run-server: --port requires a value" >&2; exit 1; }
      port="$2"
      shift 2
      ;;
    *)
      echo "run-server: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

data_dir="${data_dir:-${SYNCBOX_DATA_DIR:-}}"
port="${port:-${SYNCBOX_PORT:-8080}}"

if [[ -z "$data_dir" ]]; then
  echo "run-server: --data-dir <path> is required (or SYNCBOX_DATA_DIR)" >&2
  exit 1
fi

mkdir -p "$data_dir"
data_dir="$(cd "$data_dir" && pwd)"

export SYNCBOX_DATA_DIR="$data_dir"
export SYNCBOX_PORT="$port"

exec docker compose run --rm --service-ports server
